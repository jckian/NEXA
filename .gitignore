# ─────────────────────────────────────────────────────────────
# NEXA public repo keeps ONLY the runnable platform + its assets:
#   index.html  ->  NEXA-site.html  ->  program-input.html
#                    ->  program-massing-shortfloor.html
# Everything else (research scaffolding, generators, dev logs,
# agent tooling) stays local and is ignored here.
# ─────────────────────────────────────────────────────────────

# ── Dependencies ─────────────────────────────────
node_modules/

# ── Heavy media / renders (not suited to GitHub) ─
my-video/
forVideo/
*.mp4
*.mov
*.webm
# ...but let the two clips the site plays through
!NEXA/assembly_animation_v5_lineart.mp4
!NEXA/deck/scenario-260730.mp4
!NEXA/deck/nexa-30s.mp4

# RENDER is huge; keep only the one image the site needs. It lives in RENDER/VORO/ since
# 260727, and git will not look inside an excluded directory, so VORO/ has to be un-ignored
# before its contents can be excluded again.
RENDER/*
!RENDER/VORO/
RENDER/VORO/*
!RENDER/VORO/TOWER-1.png

# ── Old / retired branding & backups ─────────────
# Anchored: an unanchored "VORO/" also matches RENDER/VORO/, which holds the one render
# the public site loads.
/VORO/
BACKUP/

# ── Research scaffolding & dev tooling (local only) ─
session-log/
agentops/
TEST/
MODULE-TOOLS/
structure-generator/
massing-model-generator/
pythonFiles/
site/
.claude/
.mcp.json
CLAUDE.md
package.json
package-lock.json
# local key proxy for the program brief (reads the key from the environment)
nexa-llm.js

# ── NEXA: keep the site + loaded data, drop planning docs ─
NEXA/*.md
NEXA/intel/*.md
NEXA/intel/prompts/
NEXA/intel/data/*.md

# ── references: keep only what the platform + README use ─
references/*
!references/ProgramFormat.txt
!references/TPAC-PROGRAM-DISTRIBUTION.txt
!references/53W53-PROGRAM-DISTRIBUTION.txt
!references/System Workflow- FOR GITHUB.png
!references/UI-massing.png
!references/UI-structure.png
!references/screenshot/
references/screenshot/*
!references/screenshot/step-brief.png
!references/screenshot/step-massing.png
!references/screenshot/step-structure.png
!references/website-placeholder/
references/website-placeholder/*
!references/website-placeholder/F2-carre-03-bis.jpg
!references/website-placeholder/F2-carre-11.jpg
!references/website-placeholder/F2-carre-12.jpg

# ── Runtime artifacts ────────────────────────────
pythonFiles/fileTransfer/
__pycache__/
*.pyc

# ── Local secrets (never commit) ─────────────────
.env
.env.*
*.key
*.pem
OpenAI_ProgramDetails.py

# ── OS / editor cruft ────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
__MACOSX/

# ── Scratch / temp ───────────────────────────────
scratchpad/
*.tmp

# ── Reel / video build (local only) ──────────────
reel/
