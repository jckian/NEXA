# ─────────────────────────────────────────────────────────────
# NEXA public repo keeps ONLY the runnable platform + its assets:
#   index.html  ->  NEXA-site.html  ->  program-input.html
#                    ->  program-massing-shortfloor.html
# Everything else (research scaffolding, generators, dev logs,
# agent tooling) stays local and is ignored here.
# ─────────────────────────────────────────────────────────────

# ── Dependencies ─────────────────────────────────
node_modules/

# ── Heavy media / renders (not suited to GitHub) ─
my-video/
nexa-video/
forVideo/
*.mp4
*.mov
*.webm
# ...but let the two clips the site plays through
!NEXA/assembly_animation_v5_lineart.mp4
!NEXA/deck/scenario-260730.mp4
!NEXA/deck/nexa-30s.mp4

# RENDER is huge and nothing public loads from it any more.
RENDER/

# ── Old / retired branding & backups ─────────────
VORO/
BACKUP/

# ── Research scaffolding & dev tooling (local only) ─
session-log/
agentops/
TEST/
MODULE-TOOLS/
structure-generator/
massing-model-generator/
pythonFiles/
site/
.claude/
.mcp.json
CLAUDE.md
package.json
package-lock.json
# local key proxy for the program brief (reads the key from the environment)
nexa-llm.js

# ── NEXA: keep the site + loaded data, drop planning docs ─
NEXA/*.md
NEXA/hero/
NEXA/intel/*.md
NEXA/intel/prompts/
NEXA/intel/data/*.md
# print + video production sources for the deck; the site plays the clips, not these
NEXA/deck/kit-leaflet/
NEXA/deck/*-9x16-poster.jpg
NEXA/deck/*-script.md

# ── references: keep only what the platform + README use ─
references/*
!references/ProgramFormat.txt
!references/TPAC-PROGRAM-DISTRIBUTION.txt
!references/53W53-PROGRAM-DISTRIBUTION.txt
!references/system-workflow.png
!references/screenshot/
references/screenshot/*
!references/screenshot/wizard.png
!references/screenshot/massing.png
!references/screenshot/structure.png

# ── Runtime artifacts ────────────────────────────
pythonFiles/fileTransfer/
__pycache__/
*.pyc

# ── Local secrets (never commit) ─────────────────
.env
.env.*
*.key
*.pem
OpenAI_ProgramDetails.py

# ── OS / editor cruft ────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
__MACOSX/

# ── Scratch / temp ───────────────────────────────
scratchpad/
*.tmp

# ── Reel / video build (local only) ──────────────
reel/
# the 9:16 cuts of the two apps are published too, so a phone gets a portrait
# version of the wizard and the visualizer instead of the desktop layout

# ── Local docs / backups that are not the platform ─
*.bak
*.pdf
